{
  "name": "awesome-geospatial-data",
  "private": true,
  "description": "Curated list of publicly accessible geospatial data, APIs and live feeds.",
  "license": "CC0-1.0",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate": "node scripts/validate.mjs",
