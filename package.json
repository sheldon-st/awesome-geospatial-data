    "test": "node --test",
    "verify": "pnpm run test && pnpm run check && pnpm run lint"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "awesome-lint": "2.3.0"
  }
}
